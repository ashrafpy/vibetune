/*
 ==============================================================================
 VibeTune TCSS (Terminal Cascading Style Sheet)
 ==============================================================================
 In non-tech terms:
 Think of this file like the interior decorating blueprint for VibeTune.
 It sets the dimensions of each room (visualizer width, sidebar width, etc.)
 and defines the retro colors:
 - Background: Pitch black (#121212)
 - Accent: Spotify Green (#1DB954)
 - Borders and Dividers: Subtle charcoal grey (#535353)
 ==============================================================================
*/

/* The full terminal screen */
Screen {
    background: #121212;
    color: #FFFFFF;
}

/* The outer border wrapping the entire application */
#outer-frame {
    width: 100%;
    height: 100%;
    border: solid #535353;
    border-title-align: center;
    border-title-color: #1DB954;
    border-title-style: bold;
    background: #121212;
}

/* The upper floor (visualizer + now playing album art) */
#top-deck {
    width: 100%;
    height: 10;
    min-height: 10;
    max-height: 11;
    border-bottom: solid #535353;
}

/* Left side of upper floor: Frequency visualizer (54% width) */
#visualizer-pane {
    width: 54%;
    height: 100%;
    border-right: solid #535353;
    padding: 0 1;
}

/* Right side of upper floor: Album art, song name & scrub bar (46% width) */
#now-playing-pane {
    width: 46%;
    height: 100%;
    padding: 0 1;
}

/* The lower floor (library menu + song table) */
#bottom-deck {
    width: 100%;
    height: 1fr;
    border-bottom: solid #535353;
}

/* Left side of lower floor: Playlists & saved albums sidebar (30% width) */
#library-pane {
    width: 30%;
    height: 100%;
    border-right: solid #535353;
    padding: 0 1;
}

/* When the left sidebar is highlighted by the user, turn its border Spotify Green */
#library-pane:focus {
    border-right: solid #1DB954;
}

/* Right side of lower floor: Song table & search bar (70% width) */
#tracklist-pane {
    width: 70%;
    height: 100%;
    padding: 0 1;
}

/* Bottom status strip showing keyboard shortcut cues */
#retro-footer {
    width: 100%;
    height: 1;
    background: #121212;
    color: #B3B3B3;
}

/* The popup speaker/device selector window when you press 'd' */
DeviceSelectorModal {
    align: center middle;
    background: #121212 75%;
}

#device-modal {
    width: 90%;
    max-width: 58;
    height: auto;
    min-height: 10;
    max-height: 18;
    border: solid #1DB954;
    border-title-align: center;
    border-title-color: #1DB954;
    border-title-style: bold;
    background: #121212;
    padding: 1 2;
}
