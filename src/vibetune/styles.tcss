Screen {
    background: #121212;
    color: #FFFFFF;
}

#outer-frame {
    width: 100%;
    height: 100%;
    border: solid #535353;
    border-title-align: center;
    border-title-color: #1DB954;
    border-title-style: bold;
    background: #121212;
}

#top-deck {
    width: 100%;
    height: 10;
    min-height: 10;
    max-height: 11;
    border-bottom: solid #535353;
}

#visualizer-pane {
    width: 54%;
    height: 100%;
    border-right: solid #535353;
    padding: 0 1;
}

#now-playing-pane {
    width: 46%;
    height: 100%;
    padding: 0 1;
}

#bottom-deck {
    width: 100%;
    height: 1fr;
    border-bottom: solid #535353;
}

#library-pane {
    width: 30%;
    height: 100%;
    border-right: solid #535353;
    padding: 0 1;
}

#library-pane:focus {
    border-right: solid #1DB954;
}

#tracklist-pane {
    width: 70%;
    height: 100%;
    padding: 0 1;
}

/* footer strip */
#retro-footer {
    width: 100%;
    height: 1;
    background: #121212;
    color: #B3B3B3;
}

/* Device selector modal */
DeviceSelectorModal {
    align: center middle;
    background: #121212 75%;
}

#device-modal {
    width: 90%;
    max-width: 58;
    height: auto;
    min-height: 10;
    max-height: 18;
    border: solid #1DB954;
    border-title-align: center;
    border-title-color: #1DB954;
    border-title-style: bold;
    background: #121212;
    padding: 1 2;
}
